{
  "name": "arthi-digital-enterprises-admin",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Backend-integrated administration dashboard for Arthi Digital Enterprises",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch api/local.ts",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "build:web": "vite build",
    "start:local": "node --import tsx api/local.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "keys:licence": "tsx scripts/generate-licence-keys.ts",
    "provision:admin": "tsx scripts/provision-admin.ts",
    "token:registration": "tsx scripts/create-registration-token.ts",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset --local"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@supabase/supabase-js": "^2.49.4",
    "@tanstack/react-query": "^5.66.9",
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-router-dom": "^6.29.0",
    "recharts": "^2.15.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.3",
    "supabase": "^2.15.0",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
