# ---------------------------------------------------------------------------
# Arthi Digital Enterprises — environment template
# Copy to .env and replace placeholders before running.
# VITE_ variables are PUBLIC (bundled into the browser). Never put secrets here.
# All other variables are SERVER-ONLY and must be set in Vercel / local shell.
# ---------------------------------------------------------------------------

# Public — frontend Supabase client (anon / publishable key only)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Server-only — Supabase project URL and service-role key
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET

# Server-only — runtime and API
APP_ENV=development
API_BASE_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:5173

# Server-only — Supabase Cron calls /api/v1/cron/* with this secret
CRON_SECRET=CHANGE_ME_CRON_SECRET

# Server-only — Ed25519 private key in base64 PKCS#8 form.
# Generate with: npm run keys:licence
# The matching PUBLIC key is served by /api/v1/integration/licence/public-key.
LICENCE_SIGNING_PRIVATE_KEY=BASE64_PKCS8_ED25519_PRIVATE_KEY

# Controlled first-administrator provisioning (used by npm run provision:admin only)
# This is NOT used for application login and is not read by the frontend.
ADMIN_EMAIL=admin@arthidigitalenterprises.in
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_DISPLAY_NAME=Super Administrator
